# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Configuration (options: 'gemini' or 'openai')
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_JUDGE_MODEL=gemini-2.5-flash

# Dataset & Storage Paths
DATA_RAW_PATH=data/raw/twcs.csv
PROCESSED_DATA_PATH=data/processed/apple_support_pairs.jsonl
GOLDEN_DATA_PATH=data/golden/golden_eval_set.json

# Verbosity settings
GRPC_VERBOSITY=NONE
GLOG_minloglevel=2