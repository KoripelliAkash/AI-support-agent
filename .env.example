# Google Gemini API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_JUDGE_MODEL=gemini-3.5-flash-lite

# Dataset & Storage Paths
DATA_RAW_PATH=data/raw/twcs.csv
PROCESSED_DATA_PATH=data/processed/apple_support_pairs.jsonl
GOLDEN_DATA_PATH=data/golden/golden_eval_set.json

# Verbosity settings
GRPC_VERBOSITY=NONE
GLOG_minloglevel=2